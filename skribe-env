SKRIBE_PATH=deps/skribe
CONTRACT_PATH=deps/9lives

DOCKERFILE=./Dockerfile
VERSION=$(git rev-parse --short=7 HEAD)
TAG=runtimeverificationinc/skribe-advanced-fuzzing:${VERSION}
CONTAINER=skribe-advanced-fuzzing
K_VERSION=$(cat "${SKRIBE_PATH}/deps/k_release")
UV_VERSION=$(cat "${SKRIBE_PATH}/deps/uv_release")

skribe-build() (
  set -euxo pipefail

  skribe_dist=$(uv --project "${SKRIBE_PATH}" build 2>&1 | grep '\.whl$' | awk '{print $3}')

  docker build .                           \
    --file "${DOCKERFILE}"                 \
    --tag "${TAG}"                         \
    --build-arg K_VERSION="${K_VERSION}"   \
    --build-arg UV_VERSION="${UV_VERSION}" \
    --build-arg SKRIBE_DIST="${skribe_dist}"
)

skribe-start() (
  set -euxo pipefail
  docker run              \
    --name "${CONTAINER}" \
    --rm                  \
    --interactive         \
    --tty                 \
    --detach              \
    --user user           \
    --workdir /home/user  \
    "${TAG}"
  # Copy files while setting ownership to match the guest. Why `-a` works: https://github.com/docker/cli/issues/6870.
  docker cp --archive deps/. "${CONTAINER}:/home/user/"

  docker exec "${CONTAINER}" mkdir /home/user/skribe/skribe-fuzz-rs/.cargo
  docker cp --archive config.toml "${CONTAINER}:/home/user/skribe/skribe-fuzz-rs/.cargo/"
  docker exec "${CONTAINER}" /bin/bash -c 'cd skribe/skribe-fuzz-rs && KLLVM_LIBRARY_PATH=$(kdist which stylus-semantics.llvm-library) cargo test'
  docker exec "${CONTAINER}" /bin/bash -c 'cd skribe/skribe-fuzz-rs/fuzz && KLLVM_LIBRARY_PATH=$(kdist which stylus-semantics.llvm-library) cargo +nightly fuzz build'
)

skribe-stop() (
  set -euxo pipefail
  docker rm --force "${CONTAINER}" >/dev/null 2>&1
)

skribe-exec() (
  set -euxo pipefail
  docker exec --interactive --tty "${CONTAINER}" /bin/bash -lc "$*"
)

skribe-shell() (
  set -euxo pipefail
  docker attach "${CONTAINER}"
)
